# ExamVault Environment Configuration

# Next.js Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Backend Configuration (Required for Stage 3 & Beyond)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Server-side scheduled workers and monitoring jobs only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push Notification Configuration (Required for Stage 13)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@examvault.app

# Client-Side Security Salts & Configuration
# NOTE: Exam portal passwords are encrypted on the client using AES-GCM and the user's master password.
# No encryption keys are stored on the server.
